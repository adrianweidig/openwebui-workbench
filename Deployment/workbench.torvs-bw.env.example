# Production domain overlay for the torvs.bw handover archive.
# Copy the values you need into the ignored root .env file. Do not commit real tokens.

# Browser-visible production endpoints.
OPENWEBUI_PUBLIC_URL=https://lexi.torvs.bw
RAGFLOW_BASE_URL=https://rag.torvs.bw
SEAFILE_BASE_URL=https://seafile.torvs.bw

# Workbench API target. Use the public URL when the Workbench runs outside the
# shared Docker network; use http://openwebui:8080 only when both containers are
# attached to the same trusted runtime network.
OPENWEBUI_BASE_URL=https://lexi.torvs.bw

# Keep TLS verification enabled for the production domain. Mount a trusted CA via
# OPENWEBUI_CA_FILE or OPENWEBUI_CA_PATH if the certificate chain is private.
OPENWEBUI_TLS_VERIFY=true
OPENWEBUI_CA_FILE=
OPENWEBUI_CA_PATH=

# Required only for write/sync actions. Prefer a mounted Docker/Portainer secret.
OPENWEBUI_ADMIN_TOKEN=
OPENWEBUI_ADMIN_TOKEN_FILE=
OPENWEBUI_ADMIN_TOKEN_HOST_FILE=

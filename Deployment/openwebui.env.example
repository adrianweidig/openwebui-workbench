# Keine echten Secrets eintragen.
OFFLINE_MODE=true
ENABLE_MODEL_FILTER=true
ENABLE_RAG_WEB_SEARCH=false
ENABLE_WEB_SEARCH=false
OPENWEBUI_JUPYTER_URL=http://jupyter:8888
OPENWEBUI_JUPYTER_TOKEN=replace-with-local-token
OPENWEBUI_JUPYTER_TIMEOUT_SECONDS=60
OPENWEBUI_JUPYTER_ALLOWED_WORKDIR=/workspace
OPENWEBUI_ARTIFACT_ROOT=/app/backend/data/offline_artifacts
OPENWEBUI_OFFLINE_ADDONS_ROOT=/app/backend/data
OPENWEBUI_OFFLINE_ADDONS_PYTHON_PATH=/app/backend/data/python
NLTK_DATA=/app/backend/data/nltk_data
HF_HOME=/app/backend/data/cache/embedding/models
SENTENCE_TRANSFORMERS_HOME=/app/backend/data/cache/embedding/models
TIKTOKEN_CACHE_DIR=/app/backend/data/cache/tiktoken
WHISPER_MODEL_DIR=/app/backend/data/cache/whisper/models
PLAYWRIGHT_BROWSERS_PATH=/app/backend/data/cache/ms-playwright

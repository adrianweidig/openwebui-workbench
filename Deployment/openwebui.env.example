# Keine echten Secrets eintragen. Kopiere nur benötigte Werte in eine lokale,
# ignorierte .env und passe sie dort an.

# Image-Auswahl: online funktioniert der Default aus der Compose-Datei. Offline
# muss das jeweilige Image bereits lokal vorhanden sein.
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
JUPYTER_IMAGE=quay.io/jupyter/base-notebook:python-3.12

# Lokale Ports und OpenWebUI-Basissicherheit.
OPENWEBUI_PORT=3000
WEBUI_AUTH=true
WEBUI_SECRET_KEY=

# Offline-/Telemetry-Defaults.
OFFLINE_MODE=true
ENABLE_MODEL_FILTER=true
ENABLE_RAG_WEB_SEARCH=false
ENABLE_WEB_SEARCH=false
DO_NOT_TRACK=true
SCARF_NO_ANALYTICS=true
ANONYMIZED_TELEMETRY=false

# Jupyter-Anbindung. Der Token-Default ist nur für lokale Ersttests gedacht;
# für echte Nutzung in der lokalen .env überschreiben.
OPENWEBUI_JUPYTER_URL=http://jupyter:8888
OPENWEBUI_JUPYTER_TOKEN=local-dev-token
OPENWEBUI_JUPYTER_TIMEOUT_SECONDS=60
OPENWEBUI_JUPYTER_ALLOWED_WORKDIR=/workspace

# Containerinterne Artefakt- und Cachepfade. Die Compose-Datei nutzt named
# volumes, damit der Stack auch startet, wenn kein vorbefülltes Addon-Bundle
# mit NLTK, Playwright, Tiktoken oder Modellen vorhanden ist.
OPENWEBUI_ARTIFACT_ROOT=/app/backend/data/offline_artifacts
OPENWEBUI_OFFLINE_ADDONS_ROOT=/app/backend/data
OPENWEBUI_OFFLINE_ADDONS_PYTHON_PATH=/app/backend/data/python
NLTK_DATA=/app/backend/data/cache/nltk_data
HF_HOME=/app/backend/data/cache/embedding/models
SENTENCE_TRANSFORMERS_HOME=/app/backend/data/cache/embedding/models
TIKTOKEN_CACHE_DIR=/app/backend/data/cache/tiktoken
WHISPER_MODEL_DIR=/app/backend/data/cache/whisper/models
PLAYWRIGHT_BROWSERS_PATH=/app/backend/data/cache/ms-playwright

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace:/app \
    WORKBENCH_ROOT=/workspace \
    WORKBENCH_BUNDLED_WORKSPACE=/opt/openwebui-workbench/workspace \
    WORKBENCH_HOST=0.0.0.0 \
    WORKBENCH_PORT=8088

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY . /opt/openwebui-workbench/workspace
COPY Workbench /app/Workbench
COPY Deployment/workbench-entrypoint.sh /usr/local/bin/workbench-entrypoint

RUN chmod +x /usr/local/bin/workbench-entrypoint

EXPOSE 8088

ENTRYPOINT ["/usr/local/bin/workbench-entrypoint"]
CMD ["python", "-m", "Workbench.dashboard.server"]

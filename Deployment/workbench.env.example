# Copy selected values to a local .env file next to the repository root before
# running docker compose. Do not commit real tokens.

OPENWEBUI_IMAGE_TAG=main
WORKBENCH_IMAGE=openwebui-workbench-dashboard:local
OPENWEBUI_PORT=3000
WORKBENCH_PORT=8088

# Portainer wizard only:
# - bundled initializes /workspace from the Workbench image into a Docker volume.
# - bind mounts an existing host repository via WORKBENCH_WORKSPACE_HOST_PATH.
WORKBENCH_WORKSPACE_MODE=bundled
WORKBENCH_WORKSPACE_HOST_PATH=

# Set a stable local secret before repeated OpenWebUI restarts so sessions are
# not invalidated on every container recreation.
WEBUI_SECRET_KEY=

# For the bundled compose stack, the workbench reaches OpenWebUI through the
# Docker service name. If you run OpenWebUI outside this compose project, use
# http://host.docker.internal:3000 instead.
OPENWEBUI_BASE_URL=http://openwebui:8080
OPENWEBUI_PUBLIC_URL=http://localhost:3000

# Shared WSL/Portainer runtime:
# Use Deployment/docker-compose.shared-targets.yml when OpenWebUI, RAGFlow and
# Seafile already run in one common Docker network. The compose file starts only
# the Workbench container and does not duplicate those target services.
WORKBENCH_SHARED_DOCKER_NETWORK=ki_infra_seu_test
# For shared targets, set OPENWEBUI_PUBLIC_URL to the browser URL of that same
# shared OpenWebUI target, for example https://openwebui.top.secret. Do not leave
# it pointing at a separate localhost OpenWebUI container.
RAGFLOW_BASE_URL=http://ragflow
SEAFILE_BASE_URL=http://seafile

# Optional: persisted Portainer URL for post-start setup-doctor runtime probes.
# The probe uses no token and treats the login/API auth challenge as reachable.
PORTAINER_URL=

# For local HTTPS targets such as https://openwebui.top.secret with a private
# or self-signed certificate, prefer mounting a CA and setting OPENWEBUI_CA_FILE.
# Set OPENWEBUI_TLS_VERIFY=false only for a trusted local endpoint.
OPENWEBUI_TLS_VERIFY=true
OPENWEBUI_CA_FILE=
OPENWEBUI_CA_PATH=

# Unternehmensnetz mit eigener Root-CA:
# - WORKBENCH_ENTERPRISE_CA_HOST_FILE ist der Host-Pfad, den Docker/Portainer
#   sehen kann, z. B. /opt/company-ca/root-ca.pem.
# - docker-compose.enterprise-ca.yml mountet diese Datei nach
#   /certs/company-root-ca.pem.
# - Der Workbench-Container führt update-ca-certificates bei jedem Start aus.
WORKBENCH_ENTERPRISE_CA_HOST_FILE=
WORKBENCH_CA_BUNDLE=
WORKBENCH_SYSTEM_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Required only for the "Zu OpenWebUI synchronisieren" dashboard action.
# Prefer OPENWEBUI_ADMIN_TOKEN_FILE when the token is mounted as a Docker or
# Portainer secret. OPENWEBUI_ADMIN_TOKEN_HOST_FILE is used by generated
# Portainer compose files to bind-mount that host file read-only into Workbench.
OPENWEBUI_ADMIN_TOKEN=
OPENWEBUI_ADMIN_TOKEN_FILE=
OPENWEBUI_ADMIN_TOKEN_HOST_FILE=

# Keep the dashboard bound to localhost in docker-compose.workbench.yml unless
# you add a reverse proxy in front of it. Compose/Portainer set
# WORKBENCH_REQUIRE_AUTH=true so the dashboard refuses to start without either
# WORKBENCH_AUTH_PASSWORD or a mounted WORKBENCH_AUTH_PASSWORD_FILE.
WORKBENCH_AUTH_USERNAME=workbench
WORKBENCH_REQUIRE_AUTH=true
WORKBENCH_AUTH_PASSWORD=
WORKBENCH_AUTH_PASSWORD_FILE=
# Generated Portainer compose files and the optional local
# docker-compose.workbench-password-file.yml override can bind-mount this host
# file read-only to WORKBENCH_AUTH_PASSWORD_FILE; the setup doctor validates the
# path shape only.
WORKBENCH_AUTH_PASSWORD_HOST_FILE=
WORKBENCH_ALLOW_WRITE=true
WORKBENCH_COMMAND_TIMEOUT_SECONDS=300
WORKBENCH_AUTOMATION_ENABLED=true
WORKBENCH_AUTOMATION_INTERVAL_MINUTES=30
# Default automation runs the non-mutating workspace check. Add generate,
# import-dry-run or import-openwebui only after the admin accepts write/API effects.
WORKBENCH_AUTOMATION_ACTIONS=check
WORKBENCH_AUTOMATION_RUN_ON_START=false

# Dashboard language. German is the stable fallback; English is available with en.
WORKBENCH_LOCALE=de

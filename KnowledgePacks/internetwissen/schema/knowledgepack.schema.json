{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwebui-workbench-knowledgepack/v1",
  "title": "OpenWebUI Workbench KnowledgePack Manifest",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "version",
    "target_models",
    "offline_runtime",
    "max_total_bytes",
    "license",
    "snapshot_date",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "openwebui-workbench-knowledgepack/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "target_models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "offline_runtime": {
      "const": true
    },
    "max_total_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "default_included": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "media_type",
          "language",
          "size_bytes",
          "sha256",
          "source_type",
          "source_url",
          "update_method"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "update_method": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

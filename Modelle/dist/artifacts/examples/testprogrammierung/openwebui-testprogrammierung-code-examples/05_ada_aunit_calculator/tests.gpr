with "aunit.gpr";
with "default.gpr";

project Tests is
   for Source_Dirs use ("src", "tests");
   for Main use ("test_runner.adb");
   for Object_Dir use "obj/tests";
   for Exec_Dir use "obj/tests";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa");
   end Compiler;
end Tests;
